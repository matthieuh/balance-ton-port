          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לעולם לא לעקוב או לעצור פורטים"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "追跡も停止もしないポート"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ніколи не відстежувати й не зупиняти порти"
