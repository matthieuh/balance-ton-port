    "Never track or kill commands containing": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Befehle nie verfolgen oder stoppen, wenn sie enthalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Never track or kill commands containing"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nunca seguir ni detener comandos que contengan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ne jamais suivre ni arrêter les commandes contenant"
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "לעולם לא לעקוב או לעצור פקודות שמכילות"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "次を含むコマンドは追跡も停止もしない"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ніколи не відстежувати й не зупиняти команди, що містять"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "永不跟踪或终止包含以下内容的命令"
          }
        }
      }
    },
    "Case-insensitive, anywhere in the command line, paths included.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Groß-/Kleinschreibung egal, überall in der Befehlszeile, Pfade eingeschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Case-insensitive, anywhere in the command line, paths included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sin distinguir mayúsculas, en cualquier parte de la línea de comandos, rutas incluidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sans tenir compte de la casse, n’importe où dans la ligne de commande, chemins compris."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "ללא תלות באותיות רישיות, בכל מקום בשורת הפקודה, כולל נתיבים."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "大文字と小文字を区別せず、パスを含むコマンドラインのどこにあっても一致します。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Без урахування регістру, будь-де в командному рядку, разом зі шляхами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "不区分大小写，匹配命令行中的任意位置，包括路径。"
          }
        }
      }
    },
    "Never track or kill ports": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Ports nie verfolgen oder stoppen"
          }
        },
        "en": {
