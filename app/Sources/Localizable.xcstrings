    "Get a notification for servers that sit idle and for sessions that end with servers still running, with buttons to stop or keep them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erhalten Sie eine Mitteilung zu ungenutzten Servern und zu Sitzungen, die mit noch laufenden Servern enden, mit Tasten zum Stoppen oder Behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get a notification for servers that sit idle and for sessions that end with servers still running, with buttons to stop or keep them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Recibe una notificación por los servidores inactivos y por las sesiones que terminan con servidores aún en marcha, con botones para detenerlos o mantenerlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Recevez une notification pour les serveurs inactifs et pour les sessions qui se terminent avec des serveurs encore en marche, avec des boutons pour les arrêter ou les garder."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "קבלו התראה על שרתים שאינם בשימוש ועל סשנים שמסתיימים כששרתים עדיין פועלים, עם כפתורים לעצירה או להשארה."
          }
        },
