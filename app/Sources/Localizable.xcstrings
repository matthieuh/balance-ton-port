    },
    "A server listening on one of these, itself or through a child process.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein Server, der auf einem davon lauscht, selbst oder über einen Kindprozess."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server listening on one of these, itself or through a child process."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un servidor que escucha en uno de ellos, directamente o mediante un proceso hijo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un serveur qui écoute sur l’un d’eux, lui-même ou via un processus enfant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "needs_review",
            "value": "שרת שמאזין לאחד מהם, בעצמו או דרך תהליך בן."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "needs_review",
            "value": "これらのいずれかで待ち受けるサーバ（本体または子プロセス）。"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Сервер, що слухає один із них, сам або через дочірній процес."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "needs_review",
            "value": "在其中任一端口上监听的服务器，无论是自身还是通过子进程。"
          }
        }
      }
    },
